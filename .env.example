# 대시보드 비밀번호 (비워두면 누구나 접속 가능)
DASHBOARD_PASSWORD=

# 법인명
COMPANY_NAME=(주)더늘봄
# 매장 목록을 통째로 바꿀 때만 사용 (형식은 lib/config.ts 의 Store 참고)
# STORES_JSON=[{"id":"ssam","name":"쌈앤샤브",...}]

# 검색순위 — 네이버 개발자센터 (developers.naver.com) > 애플리케이션 등록 > 검색 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 키워드 검색량 — 네이버 검색광고 (searchad.naver.com) > 도구 > API 사용 관리
NAVER_AD_API_KEY=
NAVER_AD_SECRET=
NAVER_AD_CUSTOMER_ID=

# 리뷰 — Google Cloud Console > Places API (New) 사용 설정 후 API 키
GOOGLE_MAPS_API_KEY=

# SNS — 인스타그램 비즈니스 계정 + Meta 개발자 앱 (instagram_basic 권한)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# 주변 개업 — 지방행정 인허가 데이터 (localdata.go.kr) 오픈API 인증키
LOCALDATA_API_KEY=
# LOCALDATA_API_URL=

# 매출·입금 / 계좌 / 세금 — CODEF (codef.io)
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
CODEF_CONNECTED_ID=
# CODEF_API_HOST=https://api.codef.io

# 매일 밤 리포트 알림 — 텔레그램 @BotFather 로 봇 생성
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRON_SECRET=
